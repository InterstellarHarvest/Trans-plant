<!-- DEPRECATED (2026-07-01): superseded by the root /index.html, which has the
     real module loader, map generation, and event system. This file is kept
     for reference only — do not edit or load it. -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Trans-plant</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
<style>

/* ── Reset ──────────────────────────────────────────────────────── */
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'VT323', monospace;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  overflow: hidden;
  user-select: none;
  -webkit-user-select: none;
}

/* ── Scaling container ──────────────────────────────────────────── */
#scale-root {
  width: 960px;
  height: 640px;
  transform-origin: center center;
}

/* ── Game shell ─────────────────────────────────────────────────── */
#game {
  width: 960px;
  height: 640px;
  background: linear-gradient(180deg, #0a0e1a 0%, #060810 100%);
  display: flex;
  flex-direction: column;
  color: #d1d5db;
  position: relative;
  overflow: hidden;
  border: 2px solid #1a1a2e;
}

/* ── CRT scanline overlay ───────────────────────────────────────── */
#game::after {
  content: '';
  pointer-events: none;
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    0deg,
    rgba(0,0,0,0.08),
    rgba(0,0,0,0.08) 1px,
    transparent 1px,
    transparent 2px
  );
  z-index: 100;
}

/* ── Fonts ───────────────────────────────────────────────────────── */
.font-header {
  font-family: 'Press Start 2P', cursive;
  font-size: 10px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.font-body {
  font-family: 'VT323', monospace;
  font-size: 22px;
  line-height: 1.4;
}

.font-small {
  font-family: 'VT323', monospace;
  font-size: 18px;
}

.font-label {
  font-family: 'Press Start 2P', cursive;
  font-size: 7px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* ── Colors ──────────────────────────────────────────────────────── */
.color-cyan { color: #06b6d4; }
.color-green { color: #4ade80; }
.color-red { color: #ef4444; }
.color-amber { color: #f59e0b; }
.color-muted { color: #4a6a8a; }
.color-body { color: #b0b8c8; }

.glow-cyan { text-shadow: 0 0 6px rgba(6,182,212,0.4); }

/* ── Screen management ──────────────────────────────────────────── */
.screen { display: none; width: 100%; height: 100%; }
.screen.active { display: flex; }

/* ── TITLE SCREEN ───────────────────────────────────────────────── */
#screen-title {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24px;
  background: linear-gradient(180deg, #0a0e1a 0%, #060810 100%);
}

#screen-title .title-name {
  font-family: 'Press Start 2P', cursive;
  font-size: 28px;
  color: #06b6d4;
  text-shadow: 0 0 20px rgba(6,182,212,0.4), 0 0 40px rgba(6,182,212,0.2);
  letter-spacing: 4px;
}

#screen-title .title-sub {
  font-family: 'VT323', monospace;
  font-size: 22px;
  color: #4a6a8a;
  letter-spacing: 2px;
}

#screen-title .title-buttons {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 20px;
}

/* ── CRUISE SCREEN ──────────────────────────────────────────────── */
#screen-cruise {
  flex-direction: column;
}

/* Viewport area — top ~60% */
#cruise-viewport {
  flex: 1;
  position: relative;
  background: #060810;
  overflow: hidden;
  min-height: 0;
}

/* Placeholder star field */
#cruise-stars {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 30% 40%, rgba(6,182,212,0.03) 0%, transparent 60%);
}

/* Ship placeholder */
#cruise-ship {
  position: absolute;
  left: 50%;
  top: 55%;
  transform: translate(-50%, -50%);
  width: 64px;
  height: 40px;
  background: #1a2a3a;
  border: 2px solid #2a4a6a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #4a6a8a;
}

/* Flavor object placeholder */
.drift-object {
  position: absolute;
  font-size: 14px;
  color: #1a2a3a;
  opacity: 0.4;
}

/* AI widget — top right of viewport */
#cruise-ai-widget {
  position: absolute;
  top: 8px;
  right: 8px;
  max-width: 280px;
  padding: 8px 12px;
  background: rgba(10,14,26,0.85);
  border: 1px solid rgba(74,106,138,0.2);
  font-size: 16px;
  color: #4a6a8a;
  line-height: 1.3;
}

#cruise-ai-widget .ai-name {
  font-family: 'Press Start 2P', cursive;
  font-size: 7px;
  color: #06b6d4;
  letter-spacing: 1px;
  margin-bottom: 4px;
}

/* Day counter — top left of viewport */
#cruise-day {
  position: absolute;
  top: 8px;
  left: 8px;
  padding: 6px 10px;
  background: rgba(10,14,26,0.85);
  border: 1px solid rgba(74,106,138,0.2);
}

#cruise-day .day-number {
  font-family: 'Press Start 2P', cursive;
  font-size: 12px;
  color: #06b6d4;
  text-shadow: 0 0 6px rgba(6,182,212,0.4);
}

#cruise-day .day-deadline {
  font-size: 14px;
  color: #4a6a8a;
  margin-top: 2px;
}

/* ── Dashboard — bottom ~40% ────────────────────────────────────── */
#cruise-dashboard {
  flex-shrink: 0;
  border-top: 3px solid;
  border-color: #2a2a3e #1a1a2e #1a1a2e #2a2a3e;
  background: linear-gradient(180deg, #0f1020 0%, #0a0c18 100%);
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* Resource bars row */
#resource-bars {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 6px;
}

.resource-bar {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.resource-bar .bar-label {
  font-family: 'Press Start 2P', cursive;
  font-size: 6px;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #4a6a8a;
  display: flex;
  align-items: center;
  gap: 4px;
}

.resource-bar .bar-track {
  height: 10px;
  background: #0a0a14;
  border: 1px solid #1a1a2e;
  position: relative;
  overflow: hidden;
}

.resource-bar .bar-fill {
  height: 100%;
  transition: width 0.3s ease;
}

.bar-fill.green { background: #4ade80; }
.bar-fill.yellow { background: #f59e0b; }
.bar-fill.red { background: #ef4444; }

.resource-bar .bar-value {
  font-size: 14px;
  color: #8898a8;
  text-align: right;
}

/* Status row — crew, fab, crop, credits */
#status-row {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 4px 0;
}

/* Crew icons */
#crew-icons {
  display: flex;
  gap: 6px;
}

.crew-icon {
  width: 28px;
  height: 28px;
  border: 2px solid #2a4a6a;
  background: #1a1a2e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  cursor: pointer;
  position: relative;
}

.crew-icon.healthy { border-color: #4ade80; color: #4ade80; }
.crew-icon.injured { border-color: #f59e0b; color: #f59e0b; }
.crew-icon.dead { border-color: #333; color: #555; background: #111; }
.crew-icon.empty { border-color: #1a1a2e; border-style: dashed; color: #1a1a2e; }

/* Fab LED */
#fab-led {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 6px rgba(74,222,128,0.5);
  cursor: pointer;
  flex-shrink: 0;
}

.fab-label {
  font-size: 14px;
  color: #4a6a8a;
  margin-right: 2px;
}

/* Crop indicator */
#crop-indicator {
  display: flex;
  align-items: center;
  gap: 4px;
  cursor: pointer;
}

#crop-icon {
  font-size: 18px;
}

#crop-health-mini {
  width: 40px;
  height: 6px;
  background: #0a0a14;
  border: 1px solid #1a1a2e;
  overflow: hidden;
}

#crop-health-fill {
  height: 100%;
  background: #4ade80;
  transition: width 0.3s ease;
}

/* Credits */
#credits-display {
  margin-left: auto;
  font-family: 'Press Start 2P', cursive;
  font-size: 9px;
  color: #f59e0b;
  letter-spacing: 1px;
}

/* Nav buttons row */
#nav-buttons {
  display: flex;
  gap: 6px;
}

/* ── Retro button ───────────────────────────────────────────────── */
.retro-btn {
  background: linear-gradient(180deg, #1a1a2e 0%, #0f0f1a 100%);
  border: 3px outset #444;
  color: #d1d5db;
  font-family: 'VT323', monospace;
  font-size: 20px;
  letter-spacing: 1px;
  text-transform: uppercase;
  cursor: pointer;
  padding: 8px 16px;
  transition: background 0.1s;
}

.retro-btn:hover {
  background: linear-gradient(180deg, #222240 0%, #1a1a2e 100%);
  border-color: #556;
}

.retro-btn:active {
  border-style: inset;
  transform: translate(1px, 1px);
}

.retro-btn.accent {
  border-color: #06b6d4;
  color: #06b6d4;
  text-shadow: 0 0 6px rgba(6,182,212,0.4);
}

.retro-btn.small {
  font-size: 16px;
  padding: 6px 12px;
  border-width: 2px;
}

.retro-btn.nav {
  flex: 1;
  text-align: center;
  font-size: 16px;
  padding: 8px 6px;
}

/* ── MODAL OVERLAY ──────────────────────────────────────────────── */
#modal-overlay {
  display: none;
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.7);
  z-index: 50;
  align-items: center;
  justify-content: center;
}

#modal-overlay.active {
  display: flex;
}

#modal-frame {
  background: linear-gradient(180deg, #12142a 0%, #0a0c18 100%);
  border: 3px outset #444;
  max-width: 600px;
  max-height: 500px;
  width: 90%;
  overflow-y: auto;
  padding: 20px;
  position: relative;
}

#modal-close {
  position: absolute;
  top: 8px;
  right: 12px;
  font-size: 20px;
  color: #4a6a8a;
  cursor: pointer;
  background: none;
  border: none;
  font-family: 'VT323', monospace;
}

#modal-close:hover { color: #06b6d4; }

#modal-title {
  font-family: 'Press Start 2P', cursive;
  font-size: 10px;
  color: #06b6d4;
  letter-spacing: 2px;
  text-transform: uppercase;
  text-shadow: 0 0 6px rgba(6,182,212,0.4);
  margin-bottom: 14px;
}

#modal-body {
  font-size: 20px;
  line-height: 1.5;
  color: #b0b8c8;
  margin-bottom: 16px;
}

#modal-choices {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.modal-choice {
  padding: 10px 14px;
  border: 1px solid rgba(74,106,138,0.2);
  background: rgba(20,30,50,0.3);
  cursor: pointer;
  font-family: 'VT323', monospace;
  font-size: 20px;
  color: #c8d0e0;
  text-align: left;
  transition: background 0.12s, border-color 0.12s, padding-left 0.12s;
}

.modal-choice:hover {
  background: rgba(6,182,212,0.08);
  border-color: rgba(6,182,212,0.35);
  padding-left: 18px;
}

.modal-choice::before {
  content: "▸ ";
  color: #06b6d4;
}

.modal-choice.disabled {
  opacity: 0.4;
  cursor: not-allowed;
  pointer-events: none;
}

/* ── FULLSCREEN EVENT OVERLAY ───────────────────────────────────── */
#event-overlay {
  display: none;
  position: absolute;
  inset: 0;
  z-index: 40;
  flex-direction: column;
}

#event-overlay.active {
  display: flex;
}

#event-scene {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* Placeholder scene art */
#event-scene-art {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Press Start 2P', cursive;
  font-size: 8px;
  color: #2a3a4a;
  letter-spacing: 2px;
}

#event-panel {
  flex-shrink: 0;
  max-height: 55%;
  overflow-y: auto;
  background: linear-gradient(180deg, rgba(10,14,26,0.95) 0%, rgba(6,8,16,0.98) 100%);
  border-top: 3px solid #1a1a2e;
  padding: 16px 20px;
}

#event-title {
  font-family: 'Press Start 2P', cursive;
  font-size: 10px;
  color: #06b6d4;
  letter-spacing: 2px;
  text-shadow: 0 0 6px rgba(6,182,212,0.4);
  margin-bottom: 10px;
}

#event-ai-line {
  font-size: 16px;
  color: #4a6a8a;
  font-style: italic;
  margin-bottom: 10px;
  padding: 6px 10px;
  border-left: 2px solid rgba(74,106,138,0.3);
}

#event-body {
  font-size: 20px;
  line-height: 1.5;
  color: #b0b8c8;
  margin-bottom: 14px;
}

#event-choices {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* ── COMING SOON PLACEHOLDER ────────────────────────────────────── */
.coming-soon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  gap: 12px;
}

.coming-soon .cs-label {
  font-family: 'Press Start 2P', cursive;
  font-size: 10px;
  color: #2a3a4a;
  letter-spacing: 2px;
}

.coming-soon .cs-name {
  font-family: 'Press Start 2P', cursive;
  font-size: 14px;
  color: #4a6a8a;
  letter-spacing: 2px;
}

.coming-soon .cs-back {
  margin-top: 12px;
}

/* ── Tooltip ────────────────────────────────────────────────────── */
#tooltip {
  display: none;
  position: absolute;
  z-index: 90;
  background: rgba(10,14,26,0.95);
  border: 1px solid rgba(6,182,212,0.3);
  padding: 6px 10px;
  max-width: 240px;
  font-size: 16px;
  color: #b0b8c8;
  line-height: 1.3;
  pointer-events: none;
}

#tooltip.visible { display: block; }

/* ── Scrollbar ──────────────────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: rgba(10,10,26,0.5); }
::-webkit-scrollbar-thumb { background: rgba(74,106,138,0.5); border-radius: 3px; }

</style>
</head>
<body>

<div id="scale-root">
<div id="game">

  <!-- ═══ TITLE SCREEN ═══ -->
  <div id="screen-title" class="screen active">
    <div class="title-name">Trans-plant</div>
    <div class="title-sub">Earth is dying. You have a ship, a crop, and a plan.</div>
    <div class="title-sub" style="color:#2a3a4a; font-size:16px; margin-top:-10px">The plan is not good.</div>
    <div class="title-buttons">
      <button class="retro-btn accent" onclick="TP.startSetup()">New Game</button>
      <button class="retro-btn small" style="opacity:0.3; pointer-events:none">Continue (no save)</button>
    </div>
  </div>

  <!-- ═══ SETUP SCREEN ═══ -->
  <div id="screen-setup" class="screen">
    <div class="coming-soon">
      <div class="cs-label">Coming Soon</div>
      <div class="cs-name">Setup Screen</div>
      <div class="font-body color-muted" style="max-width:500px; text-align:center; padding:0 20px">
        Trail → AI → Captain → Crew → Crop → Ship Name
      </div>
      <button class="retro-btn accent cs-back" onclick="TP.skipSetup()">Skip to Cruise (Debug)</button>
    </div>
  </div>

  <!-- ═══ CRUISE SCREEN ═══ -->
  <div id="screen-cruise" class="screen">

    <!-- Viewport — top area -->
    <div id="cruise-viewport">
      <div id="cruise-stars"></div>
      <div id="cruise-ship">SHIP</div>

      <!-- Day counter — top left -->
      <div id="cruise-day">
        <div class="day-number">Day <span id="day-num">1</span></div>
        <div class="day-deadline">of <span id="day-max">120</span></div>
      </div>

      <!-- AI widget — top right -->
      <div id="cruise-ai-widget">
        <div class="ai-name"><span id="ai-name-display">MARV</span></div>
        <div id="ai-ambient-line">Systems nominal. I use the word 'nominal' because the accurate word would lower morale.</div>
      </div>
    </div>

    <!-- Dashboard — bottom area -->
    <div id="cruise-dashboard">

      <!-- Resource bars -->
      <div id="resource-bars">
        <div class="resource-bar" data-resource="fuel">
          <div class="bar-label">Fuel</div>
          <div class="bar-track"><div class="bar-fill green" id="bar-fuel" style="width:100%"></div></div>
        </div>
        <div class="resource-bar" data-resource="food">
          <div class="bar-label">Food</div>
          <div class="bar-track"><div class="bar-fill green" id="bar-food" style="width:100%"></div></div>
        </div>
        <div class="resource-bar" data-resource="water">
          <div class="bar-label">Water</div>
          <div class="bar-track"><div class="bar-fill green" id="bar-water" style="width:100%"></div></div>
        </div>
        <div class="resource-bar" data-resource="o2">
          <div class="bar-label">O2</div>
          <div class="bar-track"><div class="bar-fill green" id="bar-o2" style="width:100%"></div></div>
        </div>
        <div class="resource-bar" data-resource="hull">
          <div class="bar-label">Hull</div>
          <div class="bar-track"><div class="bar-fill green" id="bar-hull" style="width:100%"></div></div>
        </div>
        <div class="resource-bar" data-resource="morale">
          <div class="bar-label">Morale</div>
          <div class="bar-track"><div class="bar-fill green" id="bar-morale" style="width:75%"></div></div>
        </div>
      </div>

      <!-- Status row -->
      <div id="status-row">
        <!-- Crew icons -->
        <div id="crew-icons">
          <div class="crew-icon healthy" data-slot="captain" title="Captain">C</div>
          <div class="crew-icon healthy" data-slot="crew1" title="Crew 1">1</div>
          <div class="crew-icon healthy" data-slot="crew2" title="Crew 2">2</div>
        </div>

        <!-- Fab LED -->
        <span class="fab-label font-small">FAB</span>
        <div id="fab-led" title="Fabricator"></div>

        <!-- Crop indicator -->
        <div id="crop-indicator" title="Crop">
          <span id="crop-icon">&#127793;</span>
          <div id="crop-health-mini"><div id="crop-health-fill" style="width:80%"></div></div>
        </div>

        <!-- Credits -->
        <div id="credits-display"><span id="credits-num">200</span> cr</div>
      </div>

      <!-- Nav buttons -->
      <div id="nav-buttons">
        <button class="retro-btn nav" onclick="TP.openScreen('map')">Map</button>
        <button class="retro-btn nav" onclick="TP.openModal('inventory')">Cargo</button>
        <button class="retro-btn nav" onclick="TP.openModal('fabricate')">Fabricate</button>
        <button class="retro-btn nav" onclick="TP.openModal('log')">Log</button>
        <button class="retro-btn nav" onclick="TP.openModal('growbay')">Crop</button>
      </div>

    </div>
  </div>

  <!-- ═══ MAP SCREEN ═══ -->
  <div id="screen-map" class="screen">
    <div class="coming-soon">
      <div class="cs-label">Coming Soon</div>
      <div class="cs-name">Map — The Goldilocks Run</div>
      <div class="font-body color-muted" style="max-width:500px; text-align:center">
        FTL/StS-style node graph. Current position, visited nodes, fork branches.
      </div>
      <button class="retro-btn accent cs-back" onclick="TP.openScreen('cruise')">Back to Cruise</button>
    </div>
  </div>

  <!-- ═══ FULLSCREEN EVENT OVERLAY ═══ -->
  <div id="event-overlay">
    <div id="event-scene">
      <div id="event-scene-art">[ SCENE ART PLACEHOLDER ]</div>
    </div>
    <div id="event-panel">
      <div id="event-title">Event Title</div>
      <div id="event-ai-line">AI says something here.</div>
      <div id="event-body">Event body text goes here.</div>
      <div id="event-choices"></div>
    </div>
  </div>

  <!-- ═══ MODAL OVERLAY ═══ -->
  <div id="modal-overlay">
    <div id="modal-frame">
      <button id="modal-close" onclick="TP.closeModal()">✕</button>
      <div id="modal-title">Modal Title</div>
      <div id="modal-body">Modal content goes here.</div>
      <div id="modal-choices"></div>
    </div>
  </div>

  <!-- ═══ TOOLTIP ═══ -->
  <div id="tooltip"></div>

</div>
</div>

<script>
// ═══════════════════════════════════════════════════════════════════
// TRANS-PLANT — Engine Core
// ═══════════════════════════════════════════════════════════════════

const TP = (function() {
  'use strict';

  // ── DOM refs ─────────────────────────────────────────────────
  const $ = id => document.getElementById(id);
  const scaleRoot = $('scale-root');
  const game = $('game');
  const tooltip = $('tooltip');

  // Screens
  const screens = {
    title:  $('screen-title'),
    setup:  $('screen-setup'),
    cruise: $('screen-cruise'),
    map:    $('screen-map')
  };

  // Overlays
  const eventOverlay = $('event-overlay');
  const modalOverlay = $('modal-overlay');

  // ── State ────────────────────────────────────────────────────
  let STATE = {
    day: 1,
    dayMax: 120,
    trail: 'lunar',
    shipName: 'The Verdant Ark',

    resources: {
      fuel: 100,
      food: 100,
      water: 100,
      o2: 100,
      hull: 100,
      morale: 75
    },

    credits: 200,

    captain: { background: 'botanist', name: 'You' },
    crew: [
      { role: 'engineer', name: 'Kazuki', state: 'healthy' },
      { role: 'medic', name: 'Dr. Vasquez', state: 'healthy' }
    ],

    ai: 'marv',

    crop: {
      type: 'sweet_potato',
      health: 80,
      maxHealth: 100
    },

    fabricator: {
      health: 100,
      state: 'functional'
    },

    inventory: [],
    materials: { iron: 5, scrap: 3, gold: 200, exotic: 0, biocomponent: 0, minerals: 0 },

    flags: [],
    currentNode: 0,

    log: []
  };

  // ── Modules (loaded from JSON) ───────────────────────────────
  let MODULES = {};

  async function loadModules() {
    const base = '../modules/';
    const files = {
      ai:         base + 'ai/ai_companions.json',
      crew:       base + 'crew/crew_roster.json',
      captains:   base + 'captains/captains.json',
      crops:      base + 'crops/crops.json',
      items:      base + 'items/items.json',
      materials:  base + 'materials/materials.json',
      recipes:    base + 'recipes/recipes.json',
      mapRules:   base + 'maps/map_rules.json',
      flavor:     base + 'flavor/flavor_pools.json',
      testPath:   base + 'locations/lunar_test_path.json',
      evLaunch:   base + 'events/events_launch.json',
      evStation:  base + 'events/events_station.json',
      evPlanet:   base + 'events/events_planet.json',
      evGeneral:  base + 'events/events_general.json',
      evAsteroid: base + 'events/events_asteroid.json',
      evDerelict: base + 'events/events_derelict.json',
      evShipboard:base + 'events/events_shipboard.json',
      evCrisis:   base + 'events/events_crisis.json',
      endings:    base + 'endings/endings.json',
      failures:   base + 'failures/failures.json'
    };

    for (const [key, url] of Object.entries(files)) {
      try {
        const res = await fetch(url);
        if (res.ok) MODULES[key] = await res.json();
        else console.warn('Module not found:', key, url);
      } catch(e) {
        console.warn('Failed to load module:', key, e);
      }
    }

    console.log('Modules loaded:', Object.keys(MODULES).length);
  }

  // ── Viewport scaling ─────────────────────────────────────────
  function fitViewport() {
    const w = window.innerWidth;
    const h = window.innerHeight;
    const s = Math.min(w / 960, h / 640);
    scaleRoot.style.transform = 'scale(' + s + ')';
  }

  // ── Screen management ────────────────────────────────────────
  let currentScreen = 'title';

  function openScreen(name) {
    for (const s of Object.values(screens)) s.classList.remove('active');
    if (screens[name]) {
      screens[name].classList.add('active');
      currentScreen = name;
    }
    // Close overlays when switching screens
    eventOverlay.classList.remove('active');
    modalOverlay.classList.remove('active');
  }

  // ── Modal system ─────────────────────────────────────────────
  function openModal(type, payload) {
    const title = $('modal-title');
    const body = $('modal-body');
    const choices = $('modal-choices');
    choices.innerHTML = '';

    switch(type) {
      case 'inventory':
        title.textContent = 'Cargo Hold';
        body.innerHTML = renderInventory();
        break;
      case 'fabricate':
        title.textContent = 'Fabricator';
        body.innerHTML = renderFabricator();
        break;
      case 'log':
        title.textContent = "Ship's Log";
        body.innerHTML = renderLog();
        break;
      case 'growbay':
        title.textContent = 'Growbay';
        body.innerHTML = renderGrowbay();
        break;
      case 'crew_detail':
        title.textContent = 'Crew Detail';
        body.innerHTML = renderCrewDetail(payload);
        break;
      default:
        title.textContent = type.toUpperCase();
        body.innerHTML = '<div class="coming-soon" style="height:200px"><div class="cs-label">Coming Soon</div><div class="cs-name">' + type + '</div></div>';
    }

    modalOverlay.classList.add('active');
  }

  function closeModal() {
    modalOverlay.classList.remove('active');
  }

  // ── Modal content renderers ──────────────────────────────────
  function renderInventory() {
    let html = '<div style="color:#4a6a8a; margin-bottom:10px">Materials:</div>';
    for (const [id, count] of Object.entries(STATE.materials)) {
      if (count > 0) {
        html += '<div style="display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px solid rgba(74,106,138,0.1)">';
        html += '<span style="color:#b0b8c8; text-transform:capitalize">' + id + '</span>';
        html += '<span style="color:#06b6d4">' + count + '</span>';
        html += '</div>';
      }
    }
    if (STATE.inventory.length) {
      html += '<div style="color:#4a6a8a; margin:14px 0 10px">Items:</div>';
      for (const item of STATE.inventory) {
        html += '<div style="padding:4px 0; border-bottom:1px solid rgba(74,106,138,0.1); color:#b0b8c8">' + item + '</div>';
      }
    } else {
      html += '<div style="color:#2a3a4a; margin-top:14px">No items in cargo.</div>';
    }
    return html;
  }

  function renderFabricator() {
    const fab = STATE.fabricator;
    const misfire = getMisfireChance(fab.health);
    let html = '<div style="margin-bottom:10px">';
    html += '<span style="color:#4a6a8a">Health: </span><span style="color:' + getFabColor(fab.health) + '">' + fab.health + '%</span>';
    html += ' &nbsp; <span style="color:#4a6a8a">Misfire: </span><span style="color:' + (misfire > 10 ? '#ef4444' : '#b0b8c8') + '">' + misfire + '%</span>';
    html += '</div>';

    if (fab.state === 'broken') {
      html += '<div style="color:#ef4444; margin:10px 0">FABRICATOR OFFLINE — repair required</div>';
      return html;
    }

    html += '<div style="color:#4a6a8a; margin:10px 0">Recipes:</div>';
    const recipes = MODULES.recipes ? MODULES.recipes.recipes : [];
    for (const r of recipes) {
      if (!r.unlocked_by_default && !STATE.inventory.includes(r.requires_item)) continue;
      html += '<div style="padding:8px; margin-bottom:6px; border:1px solid rgba(74,106,138,0.2); background:rgba(20,30,50,0.3)">';
      html += '<div style="color:#06b6d4; font-size:18px">' + r.name + '</div>';
      html += '<div style="color:#4a6a8a; font-size:16px; margin-top:4px">Inputs: ';
      html += r.inputs.map(i => i.count + ' ' + i.material_id).join(', ');
      html += ' | Wear: ' + r.wear_cost + '%</div>';
      html += '</div>';
    }
    return html;
  }

  function renderLog() {
    if (!STATE.log.length) return '<div style="color:#2a3a4a">No entries yet. The journey has just begun.</div>';
    return STATE.log.map(entry =>
      '<div style="padding:6px 0; border-bottom:1px solid rgba(74,106,138,0.1); color:#b0b8c8; font-size:18px">' +
      '<span style="color:#06b6d4">Day ' + entry.day + ':</span> ' + entry.text + '</div>'
    ).join('');
  }

  function renderGrowbay() {
    const c = STATE.crop;
    const status = c.health >= 70 ? 'Thriving' : c.health >= 50 ? 'Healthy' : c.health >= 30 ? 'Struggling' : c.health > 0 ? 'Sick' : 'Dead';
    const color = c.health >= 70 ? '#4ade80' : c.health >= 50 ? '#4ade80' : c.health >= 30 ? '#f59e0b' : c.health > 0 ? '#ef4444' : '#555';
    let html = '<div style="text-align:center; font-size:36px; margin:10px 0">&#127793;</div>';
    html += '<div style="text-align:center; font-family:\'Press Start 2P\'; font-size:10px; color:#06b6d4; letter-spacing:2px; margin-bottom:14px">' + c.type.replace('_', ' ').toUpperCase() + '</div>';
    html += '<div style="display:flex; justify-content:space-between; margin-bottom:6px"><span style="color:#4a6a8a">Health</span><span style="color:' + color + '">' + c.health + '%</span></div>';
    html += '<div style="height:12px; background:#0a0a14; border:1px solid #1a1a2e; margin-bottom:14px"><div style="height:100%; width:' + c.health + '%; background:' + color + '"></div></div>';
    html += '<div style="color:' + color + '; text-align:center; margin-bottom:14px">' + status + '</div>';
    html += '<div style="color:#4a6a8a; font-size:16px; line-height:1.4">The crop is the mission. Keep it alive. Keep it watered. Get it to the colony.</div>';
    return html;
  }

  function renderCrewDetail(slot) {
    const member = slot === 'captain' ? STATE.captain : STATE.crew[parseInt(slot.replace('crew','')) - 1];
    if (!member) return '<div style="color:#2a3a4a">Empty slot.</div>';
    let html = '<div style="font-family:\'Press Start 2P\'; font-size:10px; color:#06b6d4; margin-bottom:10px">' + member.name + '</div>';
    html += '<div style="color:#4a6a8a; margin-bottom:10px; text-transform:capitalize">' + member.role + (member.background ? ' (Captain — ' + member.background + ')' : '') + '</div>';
    html += '<div style="color:#b0b8c8; font-size:18px">Status: <span style="color:#4ade80">' + (member.state || 'healthy') + '</span></div>';
    return html;
  }

  // ── Fabricator math ──────────────────────────────────────────
  function getMisfireChance(health) {
    if (health >= 100) return 0;
    if (health >= 80) return 2;
    if (health >= 60) return 8;
    if (health >= 40) return 18;
    if (health >= 20) return 35;
    if (health >= 10) return 55;
    return 80;
  }

  function getFabColor(health) {
    if (health >= 80) return '#4ade80';
    if (health >= 60) return '#a3e635';
    if (health >= 40) return '#f59e0b';
    if (health >= 20) return '#f97316';
    if (health >= 10) return '#ef4444';
    return '#991b1b';
  }

  // ── UI update ────────────────────────────────────────────────
  function updateDashboard() {
    // Resources
    const resources = ['fuel', 'food', 'water', 'o2', 'hull', 'morale'];
    for (const r of resources) {
      const val = STATE.resources[r];
      const bar = $('bar-' + r);
      if (!bar) continue;
      const pct = Math.max(0, Math.min(100, val));
      bar.style.width = pct + '%';
      bar.className = 'bar-fill ' + (pct > 50 ? 'green' : pct > 25 ? 'yellow' : 'red');
    }

    // Day
    $('day-num').textContent = STATE.day;
    $('day-max').textContent = STATE.dayMax;

    // Credits
    $('credits-num').textContent = STATE.materials.gold || 0;

    // Crop
    const cropPct = (STATE.crop.health / STATE.crop.maxHealth) * 100;
    $('crop-health-fill').style.width = cropPct + '%';
    $('crop-health-fill').style.background = cropPct > 60 ? '#4ade80' : cropPct > 30 ? '#f59e0b' : '#ef4444';

    // Fab LED
    const fabLed = $('fab-led');
    const fabColor = getFabColor(STATE.fabricator.health);
    fabLed.style.background = fabColor;
    fabLed.style.boxShadow = '0 0 6px ' + fabColor + '80';

    // Crew icons
    const crewIcons = document.querySelectorAll('.crew-icon');
    crewIcons[0].textContent = STATE.captain.name[0];
    crewIcons[0].className = 'crew-icon healthy';
    for (let i = 0; i < 2; i++) {
      if (STATE.crew[i]) {
        crewIcons[i+1].textContent = STATE.crew[i].name[0];
        crewIcons[i+1].className = 'crew-icon ' + STATE.crew[i].state;
      } else {
        crewIcons[i+1].textContent = '?';
        crewIcons[i+1].className = 'crew-icon empty';
      }
    }

    // AI name
    $('ai-name-display').textContent = STATE.ai.toUpperCase();
  }

  // ── Fullscreen event ─────────────────────────────────────────
  function showEvent(eventData) {
    if (!eventData) return;

    // Scene art placeholder
    const sceneArt = $('event-scene-art');
    sceneArt.textContent = '[ ' + (eventData.scene_type || 'scene').toUpperCase().replace('_', ' ') + ' ]';
    sceneArt.style.background = getSceneColor(eventData.scene_type);

    // Title
    $('event-title').textContent = eventData.title;

    // AI flavor
    const aiLine = eventData.ai_flavor ? eventData.ai_flavor[STATE.ai] : '';
    $('event-ai-line').textContent = aiLine || '';
    $('event-ai-line').style.display = aiLine ? 'block' : 'none';

    // Body
    $('event-body').textContent = eventData.body;

    // Choices
    const choicesEl = $('event-choices');
    choicesEl.innerHTML = '';
    if (eventData.choices) {
      for (const choice of eventData.choices) {
        const btn = document.createElement('button');
        btn.className = 'modal-choice';
        btn.textContent = choice.text;
        btn.onclick = () => resolveChoice(eventData, choice);
        choicesEl.appendChild(btn);
      }
    }

    eventOverlay.classList.add('active');
  }

  function resolveChoice(event, choice) {
    // Apply outcome
    if (choice.outcome && choice.outcome.resources) {
      for (const [key, val] of Object.entries(choice.outcome.resources)) {
        if (STATE.resources[key] !== undefined) {
          STATE.resources[key] = Math.max(0, Math.min(100, STATE.resources[key] + val));
        }
      }
    }

    // Log it
    if (choice.outcome && choice.outcome.narrative) {
      STATE.log.push({ day: STATE.day, text: choice.outcome.narrative });
    }

    // Set flag
    if (choice.outcome && choice.outcome.sets_flag) {
      STATE.flags.push(choice.outcome.sets_flag);
    }

    // Close event, show outcome briefly, return to cruise
    eventOverlay.classList.remove('active');
    updateDashboard();

    // Show outcome as a brief modal
    if (choice.outcome && choice.outcome.narrative) {
      $('modal-title').textContent = 'Outcome';
      $('modal-body').innerHTML = '<div style="color:#b0b8c8; font-size:20px; line-height:1.5">' + choice.outcome.narrative + '</div>';
      $('modal-choices').innerHTML = '<button class="retro-btn small accent" onclick="TP.closeModal()">Continue</button>';
      modalOverlay.classList.add('active');
    }
  }

  function getSceneColor(sceneType) {
    const colors = {
      'station_interior': 'linear-gradient(180deg, #1a1a2e 0%, #12142a 100%)',
      'planet_surface': 'linear-gradient(180deg, #1a2a1a 0%, #0a1a0a 100%)',
      'derelict_interior': 'linear-gradient(180deg, #2a1a1a 0%, #1a0a0a 100%)',
      'asteroid_field': 'linear-gradient(180deg, #1a1a1a 0%, #0a0a0a 100%)',
      'ship_interior': 'linear-gradient(180deg, #1a1a2e 0%, #0f0f1a 100%)',
      'growbay': 'linear-gradient(180deg, #0a2a1a 0%, #061a0e 100%)',
      'anomaly': 'linear-gradient(180deg, #2a1a3e 0%, #1a0a2e 100%)',
      'cruise': 'linear-gradient(180deg, #0a0e1a 0%, #060810 100%)'
    };
    return colors[sceneType] || colors['ship_interior'];
  }

  // ── Tooltip system ───────────────────────────────────────────
  let tooltipTimer = null;

  function attachTooltips() {
    // Resource bars
    document.querySelectorAll('.resource-bar').forEach(el => {
      const r = el.dataset.resource;
      attachTooltip(el, () => {
        const val = STATE.resources[r];
        const trend = val > 50 ? 'Stable' : val > 25 ? 'Low' : 'Critical';
        return r.charAt(0).toUpperCase() + r.slice(1) + ': ' + val + '/100\nStatus: ' + trend;
      });
    });

    // Fab LED
    attachTooltip($('fab-led'), () => {
      const h = STATE.fabricator.health;
      return 'Fabricator Health: ' + h + '%\nMisfire Chance: ' + getMisfireChance(h) + '%\nStatus: ' + STATE.fabricator.state;
    });

    // Crop
    attachTooltip($('crop-indicator'), () => {
      const c = STATE.crop;
      const status = c.health >= 70 ? 'Thriving' : c.health >= 50 ? 'Healthy' : c.health >= 30 ? 'Struggling' : 'Sick';
      return c.type.replace('_',' ') + ' — Health: ' + c.health + '%\nStatus: ' + status;
    });

    // Crew icons
    document.querySelectorAll('.crew-icon').forEach(el => {
      const slot = el.dataset.slot;
      attachTooltip(el, () => {
        const m = slot === 'captain' ? STATE.captain : STATE.crew[parseInt(slot.replace('crew','')) - 1];
        if (!m) return 'Empty slot';
        return m.name + ' — ' + m.role + '\nStatus: ' + (m.state || 'healthy');
      });
      el.addEventListener('click', () => openModal('crew_detail', slot));
    });
  }

  function attachTooltip(el, contentFn) {
    if (!el) return;
    el.addEventListener('mouseenter', (e) => {
      tooltipTimer = setTimeout(() => {
        tooltip.textContent = contentFn();
        tooltip.style.whiteSpace = 'pre-line';
        const rect = el.getBoundingClientRect();
        const gameRect = game.getBoundingClientRect();
        const scale = gameRect.width / 960;
        tooltip.style.left = ((rect.left - gameRect.left) / scale) + 'px';
        tooltip.style.top = ((rect.bottom - gameRect.top) / scale + 4) + 'px';
        tooltip.classList.add('visible');
      }, 200);
    });
    el.addEventListener('mouseleave', () => {
      clearTimeout(tooltipTimer);
      tooltip.classList.remove('visible');
    });
  }

  // ── Game flow ────────────────────────────────────────────────
  function startSetup() {
    openScreen('setup');
  }

  function skipSetup() {
    // Debug: skip straight to cruise with default state
    openScreen('cruise');
    updateDashboard();
    attachTooltips();

    // Fire the launch event
    if (MODULES.evLaunch) {
      const launchEvent = MODULES.evLaunch.find(e => e.test_path);
      if (launchEvent) {
        setTimeout(() => showEvent(launchEvent), 500);
      }
    }
  }

  // ── Debug: test events from console ──────────────────────────
  function debugEvent(moduleKey, eventId) {
    const pool = MODULES[moduleKey];
    if (!pool) { console.warn('Module not loaded:', moduleKey); return; }
    const arr = Array.isArray(pool) ? pool : pool.events || [];
    const ev = arr.find(e => e.id === eventId);
    if (ev) showEvent(ev);
    else console.warn('Event not found:', eventId);
  }

  function debugTestPath() {
    // Fire test path events in sequence
    const testEvents = [];
    for (const [key, pool] of Object.entries(MODULES)) {
      if (!Array.isArray(pool)) continue;
      for (const ev of pool) {
        if (ev.test_path && ev.test_path_position !== undefined) {
          testEvents.push(ev);
        }
      }
    }
    testEvents.sort((a, b) => a.test_path_position - b.test_path_position);
    console.log('Test path events:', testEvents.map(e => e.test_path_position + ': ' + e.title));
    return testEvents;
  }

  // ── Init ─────────────────────────────────────────────────────
  async function init() {
    fitViewport();
    window.addEventListener('resize', fitViewport);
    await loadModules();
    console.log('Trans-plant engine ready.');
    console.log('Debug: TP.debugTestPath() to see test events');
    console.log('Debug: TP.debugEvent("evStation", "event_station_001") to fire an event');
  }

  init();

  // ── Public API ───────────────────────────────────────────────
  return {
    openScreen,
    openModal,
    closeModal,
    startSetup,
    skipSetup,
    showEvent,
    debugEvent,
    debugTestPath,
    get STATE() { return STATE; },
    get MODULES() { return MODULES; }
  };

})();
</script>

</body>
</html>
