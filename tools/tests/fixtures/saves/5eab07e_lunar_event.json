 "shipLog": [
  {
   "day": 0,
   "text": "◆ Seeds are IN! ARIA has whispered encouragement into the soil! The soil seemed receptive! It's soil!",
   "voice": "aria"
  },
  {
   "day": 6,
   "text": "Arrived at The Other Bright Idea! The leg cost −5 FUEL, −4 FOOD, −2 H2O, −1 O2, 6 DAYS. Lovely view!",
   "type": "event",
   "voice": "aria"
  },
  {
   "day": 6,
   "text": "The Paperwork: we chose “Sign everything without reading”. Love that for us!",
   "type": "choice",
   "voice": "aria"
  },
  {
   "day": 6,
   "text": "You signed. +5 MORALE, 1 DAY. A win, statistically!",
   "type": "event",
   "voice": "aria"
  },
  {
   "day": 7,
   "text": "◆ Derelict ahead! ARIA calls it a pre-owned vessel! The previous owners left everything behind, which ARIA considers very generous!",
   "voice": "aria"
  },
  {
   "day": 13,
   "text": "Arrived at The One The Probe Liked! The leg cost −5 FUEL, −4 FOOD, −2 H2O, −1 O2, 6 DAYS. Lovely view!",
   "type": "event",
   "voice": "aria"
  },
  {
   "day": 13,
   "text": "◆ Soil sampler survey logged (1/3). The colony office will want this."
  },
  {
   "day": 13,
   "text": "A Commercial Opportunity: we chose “Trade pleasantries and move on”. Love that for us!",
   "type": "choice",
   "voice": "aria"
  },
  {
   "day": 13,
   "text": "You swap route gossip and weather reports — there is no weather, but… +2 MORALE, 1 DAY. A win, statistically!",
   "type": "event",
   "voice": "aria"
  },
  {
   "day": 14,
   "text": "◆ Planet ahead! ARIA has checked: it's round! Most of the best ones are!",
   "voice": "aria"
  },
  {
   "day": 20,
   "text": "Arrived at The Refueling Opportunity! The leg cost −5 FUEL, −4 FOOD, −2 H2O, −1 O2, 6 DAYS. Lovely view!",
   "type": "event",
   "voice": "aria"
  },
  {
   "day": 20,
   "text": "Supply Point 7: we chose “Refuel and leave”. Love that for us!",
   "type": "choice",
   "voice": "aria"
  },
  {
   "day": 20,
   "text": "Fuel acquired. +14 FUEL, 2 DAYS. A win, statistically!",
   "type": "event",
   "voice": "aria"
